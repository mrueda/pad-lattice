{
  "schema_version": 1,
  "kind": "demo",
  "id": "multi-agent-guided-demo",
  "title": "Review a Code Change",
  "initial_stage": "select_reviewer",
  "stages": [
    {
      "id": "select_reviewer",
      "prompt": {
        "eyebrow": "Three sessions, one surface",
        "title": "Reviewer needs permission.",
        "detail": "Builder and Tests are working. Reviewer needs permission to run a command. Its magenta selector chooses that session."
      },
      "guide_target": {"event": "select", "slot": 1, "action": null},
      "view": {
        "sessions": [
          {"slot": 0, "state": "running", "selected": true, "accent": "cyan", "label": "Builder"},
          {"slot": 1, "state": "waiting_for_approval", "selected": false, "accent": "magenta", "label": "Reviewer"},
          {"slot": 2, "state": "running", "selected": false, "accent": "lime", "label": "Tests"}
        ],
        "available_actions": []
      },
      "transitions": [
        {"event": "select", "slot": 1, "action": null, "next_stage": "approve_reviewer", "audio": "session_selected"}
      ],
      "enter_audio": "question",
      "terminal": false
    },
    {
      "id": "approve_reviewer",
      "prompt": {
        "eyebrow": "Permission requested",
        "title": "Allow the test command?",
        "detail": "Reviewer asks to run npm test outside the sandbox. The green check approves only this session's request."
      },
      "guide_target": {"event": "action", "slot": null, "action": "approve"},
      "view": {
        "sessions": [
          {"slot": 0, "state": "running", "selected": false, "accent": "cyan", "label": "Builder"},
          {"slot": 1, "state": "waiting_for_approval", "selected": true, "accent": "magenta", "label": "Reviewer"},
          {"slot": 2, "state": "running", "selected": false, "accent": "lime", "label": "Tests"}
        ],
        "available_actions": ["approve", "reject"]
      },
      "transitions": [
        {"event": "action", "slot": null, "action": "approve", "next_stage": "select_tests", "audio": "approve"},
        {"event": "action", "slot": null, "action": "reject", "next_stage": "review_declined", "audio": "reject"}
      ],
      "enter_audio": "approval",
      "terminal": false
    },
    {
      "id": "review_declined",
      "prompt": {
        "eyebrow": "Request declined",
        "title": "The command did not run.",
        "detail": "Reviewer did not receive permission. Builder and Tests were not interrupted."
      },
      "guide_target": null,
      "view": {
        "sessions": [
          {"slot": 0, "state": "running", "selected": false, "accent": "cyan", "label": "Builder"},
          {"slot": 1, "state": "cancelled", "selected": true, "accent": "magenta", "label": "Reviewer"},
          {"slot": 2, "state": "running", "selected": false, "accent": "lime", "label": "Tests"}
        ],
        "available_actions": []
      },
      "transitions": [],
      "enter_audio": "cancelled",
      "terminal": true
    },
    {
      "id": "select_tests",
      "prompt": {
        "eyebrow": "Permission granted",
        "title": "Now Tests needs a decision.",
        "detail": "Reviewer is working again. Tests wants to install a dependency. Its lime selector chooses this new request."
      },
      "guide_target": {"event": "select", "slot": 2, "action": null},
      "view": {
        "sessions": [
          {"slot": 0, "state": "running", "selected": false, "accent": "cyan", "label": "Builder"},
          {"slot": 1, "state": "running", "selected": true, "accent": "magenta", "label": "Reviewer"},
          {"slot": 2, "state": "waiting_for_approval", "selected": false, "accent": "lime", "label": "Tests"}
        ],
        "available_actions": []
      },
      "transitions": [
        {"event": "select", "slot": 2, "action": null, "next_stage": "reject_tests", "audio": "session_selected"}
      ],
      "enter_audio": null,
      "terminal": false
    },
    {
      "id": "reject_tests",
      "prompt": {
        "eyebrow": "A different session, a different decision",
        "title": "Decline the installation.",
        "detail": "Tests requests npm install. The red cross refuses this request without stopping Builder or Reviewer."
      },
      "guide_target": {"event": "action", "slot": null, "action": "reject"},
      "view": {
        "sessions": [
          {"slot": 0, "state": "running", "selected": false, "accent": "cyan", "label": "Builder"},
          {"slot": 1, "state": "running", "selected": false, "accent": "magenta", "label": "Reviewer"},
          {"slot": 2, "state": "waiting_for_approval", "selected": true, "accent": "lime", "label": "Tests"}
        ],
        "available_actions": ["reject"]
      },
      "transitions": [
        {"event": "action", "slot": null, "action": "reject", "next_stage": "complete", "audio": "reject"}
      ],
      "enter_audio": "approval",
      "terminal": false
    },
    {
      "id": "complete",
      "prompt": {
        "eyebrow": "Demo complete",
        "title": "Two decisions. The right agents.",
        "detail": "Reviewer finished. Tests did not install the dependency. Builder kept working. No real commands were run in this demonstration."
      },
      "guide_target": null,
      "view": {
        "sessions": [
          {"slot": 0, "state": "running", "selected": false, "accent": "cyan", "label": "Builder"},
          {"slot": 1, "state": "success", "selected": false, "accent": "magenta", "label": "Reviewer"},
          {"slot": 2, "state": "cancelled", "selected": true, "accent": "lime", "label": "Tests"}
        ],
        "available_actions": []
      },
      "transitions": [],
      "enter_audio": "cancelled",
      "terminal": true
    }
  ]
}
