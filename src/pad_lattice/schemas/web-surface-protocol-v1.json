{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrueda.github.io/pad-lattice/schemas/web-surface-protocol-v1.json",
  "title": "Pad-Lattice Web Surface Protocol v1",
  "oneOf": [
    {"$ref": "#/$defs/authenticate"},
    {"$ref": "#/$defs/action"},
    {"$ref": "#/$defs/selectSession"},
    {"$ref": "#/$defs/createPairing"},
    {"$ref": "#/$defs/revokeRemote"},
    {"$ref": "#/$defs/startExperience"},
    {"$ref": "#/$defs/stopExperience"},
    {"$ref": "#/$defs/questionRequest"},
    {"$ref": "#/$defs/questionResponse"},
    {"$ref": "#/$defs/authenticated"},
    {"$ref": "#/$defs/pairing"},
    {"$ref": "#/$defs/surface"},
    {"$ref": "#/$defs/experienceState"},
    {"$ref": "#/$defs/performanceFrame"},
    {"$ref": "#/$defs/audioCue"},
    {"$ref": "#/$defs/deviceDisconnected"},
    {"$ref": "#/$defs/remoteRevoked"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "questionRequest": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
         "required": ["protocol", "type", "request_id", "operation"],
         "properties": {"protocol": {"const": 1}, "type": {"const": "question_request"},
           "request_id": {"type": "string", "minLength": 1, "maxLength": 64}, "operation": {"const": "status"}}},
        {"type": "object", "additionalProperties": false,
         "required": ["protocol", "type", "request_id", "operation", "slot", "revision", "token", "answers"],
         "properties": {"protocol": {"const": 1}, "type": {"const": "question_request"},
           "request_id": {"type": "string", "minLength": 1, "maxLength": 64}, "operation": {"const": "answer"},
           "slot": {"type": "integer", "minimum": 0, "maximum": 7}, "revision": {"type": "integer", "minimum": 0},
           "token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
           "answers": {"type": "object", "minProperties": 1, "maxProperties": 3,
             "propertyNames": {"minLength": 1, "maxLength": 128},
             "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 8}}}}
      ]
    },
    "questionResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "type", "request_id"],
      "properties": {"protocol": {"const": 1}, "type": {"const": "question_response"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "result": {"oneOf": [
          {"type": "object", "maxProperties": 0},
          {"type": "object", "additionalProperties": false, "required": ["question", "slot", "revision"],
            "properties": {
              "slot": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
              "revision": {"type": ["integer", "null"], "minimum": 0},
              "question": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pendingQuestion"}]}
            }}]},
        "error": {"type": "string"}},
      "oneOf": [{"required": ["result"]}, {"required": ["error"]}]
    },
    "pendingQuestion": {
      "type": "object", "additionalProperties": false, "required": ["token", "questions"],
      "properties": {
        "token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "questions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "header", "question", "options"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 128},
            "header": {"type": "string", "maxLength": 256},
            "question": {"type": "string", "minLength": 1, "maxLength": 4096},
            "options": {"type": "array", "minItems": 1, "maxItems": 9, "items": {
              "type": "object", "additionalProperties": false, "required": ["label", "description"],
              "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 512},
                             "description": {"type": "string", "maxLength": 2048}}
            }}
          }
        }}
      }
    },
    "deviceDisconnected": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "type"],
      "properties": {"protocol": {"const": 1}, "type": {"const": "device_disconnected"}}
    },
    "audioCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "cue", "slot"],
      "properties": {
        "protocol": {"const": 1},
        "type": {"const": "audio_cue"},
        "cue": {"enum": ["question", "approval", "approve", "reject", "retry", "stop", "success", "error", "cancelled", "session_selected", "unavailable"]},
        "slot": {"type": ["integer", "null"], "minimum": 0, "maximum": 7}
      }
    },
    "protocol": {"const": 1},
    "actionName": {"enum": ["approve", "reject", "stop", "retry"]},
    "stateName": {
      "enum": [
        "idle", "running", "waiting_for_reply", "user_typing",
        "waiting_for_approval", "success", "error", "cancelled"
      ]
    },
    "authenticate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "authenticate"},
        "credential": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "action"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "action"},
        "action": {"$ref": "#/$defs/actionName"},
        "expected_revision": {"type": "integer", "minimum": 0}
      }
    },
    "selectSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "slot"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "select_session"},
        "slot": {"type": "integer", "minimum": 0, "maximum": 7},
        "expected_revision": {"type": "integer", "minimum": 0}
      }
    },
    "createPairing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "create_pairing"}
      }
    },
    "revokeRemote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "revoke_remote"}
      }
    },
    "startExperience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "kind"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "start_experience"},
        "kind": {"enum": ["demo", "show"]}
      }
    },
    "stopExperience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "stop_experience"}
      }
    },
    "authenticated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "admin", "session_token", "lan_enabled"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "authenticated"},
        "admin": {"type": "boolean"},
        "session_token": {"type": ["string", "null"]},
        "lan_enabled": {"type": "boolean"}
      }
    },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "pin", "pairing_url", "qr_data_uri", "expires_in"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "pairing"},
        "pin": {"type": "string", "pattern": "^[0-9]{6}$"},
        "pairing_url": {"type": "string"},
        "qr_data_uri": {"type": "string", "pattern": "^data:image/svg\\+xml"},
        "expires_in": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "state", "selected", "accent", "label"],
      "properties": {
        "slot": {"type": "integer", "minimum": 0, "maximum": 7},
        "state": {"$ref": "#/$defs/stateName"},
        "selected": {"type": "boolean"},
        "accent": {"enum": ["cyan", "magenta", "lime", "orange", "violet", "teal", "rose", "sky"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "visual_protocol", "view", "visual_frame"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "surface"},
        "visual_protocol": {"const": 1},
        "view": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_state", "frame", "sessions", "available_actions", "overflow_count", "activity_motion"],
          "properties": {
            "selected_state": {"oneOf": [{"$ref": "#/$defs/stateName"}, {"type": "null"}]},
            "frame": {"type": "integer", "minimum": 0},
            "sessions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/session"}},
            "available_actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/actionName"}},
            "overflow_count": {"type": "integer", "minimum": 0},
            "activity_motion": {"type": "boolean"},
            "control_revision": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "visual_frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "selectors", "statuses", "actions", "overflow"],
          "properties": {
            "state": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "array",
                "minItems": 7,
                "maxItems": 7,
                "items": {"type": "string"}
              }
            },
            "selectors": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
            "statuses": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
            "actions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["approve", "reject", "stop", "retry"],
              "properties": {
                "approve": {"type": "string"},
                "reject": {"type": "string"},
                "stop": {"type": "string"},
                "retry": {"type": "string"}
              }
            },
            "overflow": {"type": "string"}
          }
        }
      }
    },
    "experienceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol", "type", "status", "kind", "title", "cue_index",
        "caption", "detail", "elapsed_ms", "duration_ms", "tempo", "audio_asset",
        "audio_cue", "audio_slot", "audio_sequence", "start_delay_ms", "reason"
      ],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "experience_state"},
        "status": {"enum": ["idle", "blocked", "starting", "playing"]},
        "kind": {"type": ["string", "null"], "enum": ["demo", "show", null]},
        "title": {"type": ["string", "null"]},
        "cue_index": {"type": ["integer", "null"], "minimum": 0},
        "caption": {"type": ["string", "null"]},
        "detail": {"type": ["string", "null"]},
        "elapsed_ms": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": ["integer", "null"], "minimum": 1},
        "tempo": {"type": "number", "exclusiveMinimum": 0},
        "audio_asset": {"type": ["string", "null"]},
        "audio_cue": {"type": ["string", "null"]},
        "audio_slot": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
        "audio_sequence": {"type": "integer", "minimum": 0},
        "start_delay_ms": {"type": "integer", "minimum": 0},
        "reason": {"type": ["string", "null"]}
      }
    },
    "rgbHex": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
    "performanceRail": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/rgbHex"}
    },
    "performanceFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "grid", "top", "right"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "performance_frame"},
        "grid": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/performanceRail"}
        },
        "top": {"$ref": "#/$defs/performanceRail"},
        "right": {"$ref": "#/$defs/performanceRail"}
      }
    },
    "remoteRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "remote_revoked"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "type", "code", "error"],
      "properties": {
        "protocol": {"$ref": "#/$defs/protocol"},
        "type": {"const": "error"},
        "code": {"type": "string"},
        "error": {"type": "string"}
      }
    }
  }
}
